# Copia questo file in .env e completa i valori.

# Dominio pubblico del sito (senza barra finale) e cartella da cui è servito.
VITE_SITE_ORIGIN=https://www.example.org
VITE_BASE_PATH=/
# "index, follow" solo sul sito definitivo; le anteprime restano "noindex, nofollow".
VITE_ROBOTS=noindex, nofollow

# Indirizzo base del backend dei consensi cookie (il sito chiama /consent/config e /consent;
# deve accettare richieste CORS dal dominio del sito).
VITE_CONSENT_API_URL=https://amosport.it

# Versione della Cookie Policy usata finché non arriva quella del backend (/consent/config):
# conviene tenerla uguale a quella configurata sul backend.
VITE_COOKIE_POLICY_VERSION=2026-10-08
