# Build per il nostro server (npm run build:server): i file vanno nella cartella /frontend/restainup/
# del server, che è la radice del dominio https://www.restainup.it (quindi base "/").
# Sovrascrive solo indirizzo, cartella e indicizzazione; le altre variabili arrivano da .env
# (i consensi cookie vanno comunque a VITE_CONSENT_API_URL=https://amosport.it).
VITE_SITE_ORIGIN=https://www.restainup.it
VITE_BASE_PATH=/
VITE_ROBOTS=index, follow
